{
  "name": "@repo/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "parcel public/index.html --open --dist-dir build",
    "build": "parcel build public/index.html --dist-dir build",
    "eslint": "eslint src --ext .js,.jsx,.json",
    "lint": "npm run prettier && npm run eslint",
    "prettier": "prettier src --write",
    "test": "jest"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/testing-fixtures": "*",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "eslint": "^8.57.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^29.7.0",
    "parcel": "^2.11.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "prettier": "^2.0.5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "staticFiles": [
    {
      "staticPath": "../import/output/data",
      "staticOutPath": "data"
    },
    {
      "staticPath": "../import/output/cards",
      "staticOutPath": "img/cards"
    },
    {
      "staticPath": "public/favicon.ico"
    }
  ]
}

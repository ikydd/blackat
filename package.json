{
  "name": "blackat",
  "version": "1.14.0",
  "author": "Iain Kydd <iain.kydd@gmail.com>",
  "workspaces": [
    "packages/**/*",
    "apps/**/*"
  ],
  "packageManager": "npm@8.19.4",
  "scripts": {
    "build": "turbo run build",
    "move:data": "mkdir -p client/build/data && cp client/public/data/* client/build/data",
    "update:data": "npm run build:data && npm run move:data",
    "test": "turbo run test",
    "watch": "jest --watch",
    "test:client": "jest client",
    "test:import": "jest import",
    "watch:import": "jest import/**/*.test.js --watch",
    "unit:import": "jest import/**/*.test.js",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "turbo": "^2.9.14"
  }
}

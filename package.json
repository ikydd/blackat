{
  "name": "blackat",
  "version": "1.14.0",
  "author": "Iain Kydd <iain.kydd@gmail.com>",
  "workspaces": [
    "packages/**/*",
    "apps/**/*"
  ],
  "packageManager": "npm@8.19.4",
  "scripts": {
    "build": "turbo run build",
    "move:data": "mkdir -p apps/client/build/data && cp apps/import/output/data/* apps/client/build/data",
    "update:data": "npm -w @repo/import start && npm run move:data",
    "test": "turbo run test",
    "watch": "turbo watch test",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "turbo": "^2.9.14"
  },
  "devDependencies": {
    "process": "^0.11.10"
  }
}
